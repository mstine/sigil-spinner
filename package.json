{
  "name": "@falkensmage/sigil-spinner",
  "version": "1.0.0",
  "description": "Generates traditional Western esoteric planetary sigils from intention statements as embeddable, fully CSS-stylable inline SVG.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "sigil-spinner": "./bin/sigil-spinner.js"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run test/browser",
    "typecheck": "tsc --allowJs --checkJs --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "sigil",
    "kamea",
    "planetary-magic",
    "svg",
    "esoteric"
  ],
  "author": "Matt Stine (https://github.com/mstine)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mstine/sigil-spinner.git"
  },
  "homepage": "https://github.com/mstine/sigil-spinner",
  "bugs": {
    "url": "https://github.com/mstine/sigil-spinner/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
