{
  "name": "sigil-spinner",
  "version": "0.1.0",
  "description": "Generates traditional Western esoteric planetary sigils from intention statements as embeddable, fully CSS-stylable inline SVG.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "sigil-spinner": "./bin/sigil-spinner.js"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --allowJs --checkJs --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "sigil",
    "kamea",
    "planetary-magic",
    "svg",
    "esoteric"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
