{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "bin/**/*.js", "test/**/*.js", "scripts/**/*.js", "*.js"],
  "exclude": ["node_modules"]
}
